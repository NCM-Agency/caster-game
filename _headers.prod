# PRODUCTION - Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=() microphone=() geolocation=() payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com https://connect.facebook.net https://s3.amazonaws.com https://code.jquery.com https://media.us15.list-manage.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://*.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://www.facebook.com https://www.google-analytics.com https://*.doubleclick.net https://res.cloudinary.com https://www.google.com https://googleads.g.doubleclick.net; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.facebook.com https://www.facebook.com/tr/ https://connect.facebook.net https://media.us15.list-manage.com https://identitytoolkit.googleapis.com https://region1.google-analytics.com https://analytics.google.com https://*.doubleclick.net https://graph.facebook.com; frame-src https://www.google.com https://www.googletagmanager.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://td.doubleclick.net https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self' https://media.us15.list-manage.com https://www.facebook.com/tr/;

# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS
/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800